#. module: cron_tick
#: model:ir.model.fields,help:cron_tick.field_cron_task_log__status
msgid ""
"ok = the method returned without error.\n"
"error = the method raised; see the text.\n"
"locked = another session was running the task; the method was not called.\n"
"skipped = the engine decided not to run it (nothing to clean up, task inactive)."
msgstr ""
"ok = 方法执行成功。\n"
"error = 方法抛出异常，详见说明。\n"
"locked = 其他会话正在执行，本次未调用方法。\n"
"skipped = 调度器决定不运行，例如无待清理内容或任务未启用。"

