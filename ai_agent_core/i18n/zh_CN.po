#. module: ai_agent_core
#: model_terms:ir.ui.view,arch_db:ai_agent_core.view_ai_personal_goal_form
msgid "Why does this matter?"
msgstr "这为什么重要？"

#. module: ai_agent_core
#: model:ir.model.fields,help:ai_agent_core.field_ai_coworker_skill__feedback_notes
msgid "Why improvements were proposed/rejected"
msgstr "提出或拒绝改进的原因"

#. module: ai_agent_core
#: model:ir.model.fields,help:ai_agent_core.field_ai_coworker_session__last_close_reason
msgid ""
"Why the session was closed most recently. The full history is in the close "
"events."
msgstr "最近关闭会话的原因，完整历史在结束事件中。"

#. module: ai_agent_core
#: model:ir.model.fields,help:ai_agent_core.field_ai_coworker_session_close_event__reason
msgid ""
"Why the session was closed. The difference from `finish_reason`: "
"finish_reason says why the TURN ended, reason why the SESSION was closed."
msgstr "关闭会话的原因。finish_reason 表示本轮结束原因，此字段表示整个会话关闭原因。"

