#. module: ai_agent_core
#. odoo-python
#: code:addons/ai_agent_core/models/ai_coworker.py:0
msgid ""
"# Example 1 — simple run (a session is created automatically)\n"
"result = %(ref)s.run(\"Your question here\")\n"
"\n"
"# Example 2 — with your own session (tracked in Odoo Mind)\n"
"sess = env[\"ai.coworker.session\"].create({\n"
"    \"coworker_id\": %(eid)s,\n"
"    \"status\": \"active\",\n"
"    \"name\": \"My Task\",\n"
"})\n"
"result = %(ref)s.run(\"Your question here\", session=sess)\n"
"\n"
"# Example 3 — server action code (runs on the selected records)\n"
"coworker = %(ref)s\n"
"coworker.run(\"Analyse \" + records.display_name, records=records)\n"
"\n"
"# NOTE: for tools that write (odoo_create/odoo_write) in automated flows:\n"
"result = %(ref)s.with_context(_ai_auto_approve=True).run(\"Your question\")\n"
msgstr ""
"# 示例 1：直接运行（自动创建会话）\n"
"result = %(ref)s.run(\"请在此填写要处理的问题\")\n"
"\n"
"# 示例 2：使用自己的会话（可在知识中心追踪）\n"
"sess = env[\"ai.coworker.session\"].create({\n"
"    \"coworker_id\": %(eid)s,\n"
"    \"status\": \"active\",\n"
"    \"name\": \"我的任务\",\n"
"})\n"
"result = %(ref)s.run(\"请在此填写要处理的问题\", session=sess)\n"
"\n"
"# 示例 3：服务器动作代码（处理当前选中的记录）\n"
"coworker = %(ref)s\n"
"coworker.run(\"分析 \" + records.display_name, records=records)\n"
"\n"
"# 提示：自动流程需要创建或修改数据（odoo_create/odoo_write）时：\n"
"result = %(ref)s.with_context(_ai_auto_approve=True).run(\"请填写要处理的问题\")\n"

