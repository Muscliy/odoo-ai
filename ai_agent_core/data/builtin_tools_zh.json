        "value": "{\"type\": \"object\", \"properties\": {\"coworker_id\": {\"type\": \"integer\", \"description\": \"\\u8981\\u66f4\\u65b0\\u7684 AI \\u5458\\u5de5 ID\\u3002\"}, \"name\": {\"type\": \"string\"}, \"description\": {\"type\": \"string\"}, \"orchestration_mode\": {\"type\": \"string\", \"enum\": [\"single\", \"supervisor\", \"buzz\"]}}, \"required\": [\"coworker_id\"]}"
      }
    }
  },
  {
    "builtin_name": "builder_create_agent",
    "fields": {
      "description": {
        "source_sha256": "4e83f660336f42fb312cac326fcdf5ab3d832530a852c60d315a8b2e6b70fa95",
        "value": "创建 ai.agent。name 必填，可填写 description、model（Bifrost 模型名）、skills（逗号分隔的技能名）。返回智能体 ID。"
      },
      "parameters": {
        "source_sha256": "4794bd0071dfa317eef73e60a1977a1a68152f2b8187482103f8b027d983b3d7",
        "value": "{\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\", \"description\": \"\\u667a\\u80fd\\u4f53\\u540d\\u79f0\\u3002\"}, \"description\": {\"type\": \"string\", \"description\": \"\\u667a\\u80fd\\u4f53\\u8bf4\\u660e\\u4e0e\\u89d2\\u8272\\u3002\"}, \"model\": {\"type\": \"string\", \"description\": \"AI \\u6a21\\u578b\\u540d\\u79f0\\uff0c\\u4f8b\\u5982 cheap\\u3001moderate\\u3001deepseek/deepseek-chat\\u3002\"}, \"skills\": {\"type\": \"string\", \"description\": \"\\u8981\\u5173\\u8054\\u7684\\u5df2\\u6709\\u6280\\u80fd\\u540d\\u79f0\\uff0c\\u4f7f\\u7528\\u9017\\u53f7\\u5206\\u9694\\u3002\"}}, \"required\": [\"name\"]}"
      }
    }
  },
  {
    "builtin_name": "builder_create_skill",
    "fields": {
      "description": {
        "source_sha256": "9927e50d4dd631b1e7837b97f07e0e44fb9ae1aae21b40b84deb61ba3b311f68",
        "value": "创建 ai.skill。name 必填，可填写 category、recipe_text（完整 Markdown 操作说明）、trigger_keywords。"
      },
      "parameters": {
        "source_sha256": "56bedcc3623aa20c918600e5c44bb8193b0e2483884c7cab4b73d460d8d00bf2",
        "value": "{\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\", \"description\": \"\\u6280\\u80fd\\u6280\\u672f\\u540d\\u79f0\\u3002\"}, \"category\": {\"type\": \"string\", \"description\": \"\\u5206\\u7c7b\\u6807\\u8bc6\\uff1ageneral\\u3001analysis\\u3001accounting\\u3001development\\u3001infrastructure\\u3001communication\\u3001research\\u3002\"}, \"recipe_text\": {\"type\": \"string\", \"description\": \"\\u6b64\\u6280\\u80fd\\u7684\\u5b8c\\u6574 Markdown \\u64cd\\u4f5c\\u8bf4\\u660e\\u3002\"}, \"trigger_keywords\": {\"type\": \"string\", \"description\": \"\\u89e6\\u53d1\\u6b64\\u6280\\u80fd\\u7684\\u5173\\u952e\\u8bcd\\uff0c\\u4f7f\\u7528\\u9017\\u53f7\\u5206\\u9694\\u3002\"}}, \"required\": [\"name\", \"recipe_text\"]}"
      }
    }
  },
  {
    "builtin_name": "builder_assign_agent",
    "fields": {
      "description": {
        "source_sha256": "4943c3dc3543e32be8304b2491cce0a659b570d327b3ee29c7bf8559862c09ed",
        "value": "将智能体分配给 AI 员工。参数：coworker_id、agent_id、可选 sequence。"
      },
      "parameters": {
        "source_sha256": "63c343cd228c8a843e305a2d505753fbbcbc71046ed9520af58588a46e358c40",
        "value": "{\"type\": \"object\", \"properties\": {\"coworker_id\": {\"type\": \"integer\"}, \"agent_id\": {\"type\": \"integer\"}, \"sequence\": {\"type\": \"integer\", \"description\": \"\\u667a\\u80fd\\u4f53\\u5728\\u5904\\u7406\\u6d41\\u7a0b\\u4e2d\\u7684\\u987a\\u5e8f\\uff0c\\u4ece 1 \\u5f00\\u59cb\\u3002\"}}, \"required\": [\"coworker_id\", \"agent_id\"]}"
      }
    }
  },
  {
    "builtin_name": "builder_configure_init_type",
    "fields": {
      "description": {
        "source_sha256": "0864bdea52409342cdcc716870f07e4fa270fd67a527e847e0716724e9ddb485",
        "value": "配置 AI 员工的启动方式。参数：coworker_id、init_type（web_ui、chat、channel、mail、cron、server_action、powerbox、manual、openai_api）和 config_json（该启动方式的配置）。"
      },
      "parameters": {
        "source_sha256": "9e392d32e9b8df27e8d5811df79070c500f44753ba7293cb249316a50a226705",
        "value": "{\"type\": \"object\", \"properties\": {\"coworker_id\": {\"type\": \"integer\"}, \"init_type\": {\"type\": \"string\", \"description\": \"\\u8981\\u914d\\u7f6e\\u7684\\u542f\\u52a8\\u65b9\\u5f0f\\u3002\"}, \"config\": {\"type\": \"string\", \"description\": \"JSON \\u914d\\u7f6e\\uff1a\\u5feb\\u6377\\u64cd\\u4f5c\\u793a\\u4f8b {\\\"model_ids\\\": [\\\"sale.order\\\",\\\"crm.lead\\\"]}\\uff1b\\u90ae\\u4ef6\\u793a\\u4f8b {\\\"alias_name\\\":\\\"support\\\"}\\u3002\"}}, \"required\": [\"coworker_id\", \"init_type\"]}"
      }
    }
  },
  {
    "builtin_name": "builder_link_skill_to_agent",
    "fields": {
      "description": {
        "source_sha256": "774ca7979fa55589d99ca902512663b55f1fc24164e1348065d4b634407c68fc",
        "value": "关联已有技能和智能体。参数：agent_id、skill_id。"
      }
    }
  },
  {
    "builtin_name": "read_skill",
    "fields": {
      "description": {
        "source_sha256": "a2ff2e64b9d8439dff018afce4533f7b50fcea5b1683590a36a3e0d2a853f467",
        "value": "读取 ai.skill 的完整 recipe_text 操作说明。参数：skill_id。"
      }
    }
  },
  {
    "builtin_name": "search_github_skills",
    "fields": {
      "description": {
        "source_sha256": "b0b156cfb93ab02e130a53d9ce26e88878f79d3c42d0a68afb9893065500968b",
        "value": "在 GitHub 中查找匹配 query 的 SKILL.md 文件，返回仓库、文件路径和原文网址。"
      }
    }
  },
  {
    "builtin_name": "builder_draft_skill",
    "fields": {
      "description": {
        "source_sha256": "041ed17716e220543ce8d5cda14c00ea3e9c7f8815a182f5cf622717934f29b1",
        "value": "创建用于测试的临时技能草稿。name 必填，可填写 recipe_text、category、trigger_keywords。"
      }
    }
  },
  {
    "builtin_name": "builder_test_skill",
    "fields": {
      "description": {
        "source_sha256": "c88b0c1ec0316ace1295847063588fc9225fdb207e5f741895113166e9a6e4c6",
        "value": "使用临时 AI 员工运行 prompt 测试技能。参数：skill_id、prompt，返回 AI 回复。"
      }
    }
  },
  {
    "builtin_name": "builder_improve_skill",
    "fields": {
      "description": {
        "source_sha256": "5c5e4e7226ae24616c1b849bbae2567a8a81765283757d0eff2e8e10024ed378",
        "value": "根据用户反馈更新技能。参数：skill_id、feedback、field。"
      },
      "parameters": {
        "source_sha256": "43f69d2a3450c491b6aaeafd7bb8b396ef58b3c47c0334c8b111e0212b814328",
        "value": "{\"type\": \"object\", \"properties\": {\"skill_id\": {\"type\": \"integer\"}, \"feedback\": {\"type\": \"string\"}, \"field\": {\"type\": \"string\", \"description\": \"\\u8981\\u4fee\\u6539\\u7684\\u5b57\\u6bb5\\uff1arecipe_text\\u3001trigger_keywords\\u3001description\\u3001category\\u3002\"}}, \"required\": [\"skill_id\", \"feedback\"]}"
      }
    }
  },
  {
    "builtin_name": "describe_model",
    "fields": {
      "description": {
        "source_sha256": "f7612f9c3b7d7ce3160b07ae2a0137a8a2378f2ef7fa01ce101548290746afe5",
        "value": "返回模型结构：字段类型、只读和计算属性，关系，可调用的 action_*、button_* 方法，以及 has_okf、has_graph、has_embedding 能力。查询或写入模型前使用。"
      },
      "parameters": {
        "source_sha256": "e1b532cddd3b40239227297e4bfb6158859d97cf2c5f0b0d2c53a63723f45a81",
        "value": "{\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\", \"description\": \"Odoo \\u6a21\\u578b\\u6280\\u672f\\u540d\\u79f0\\uff0c\\u4f8b\\u5982 crm.lead\\u3002\", \"example\": \"res.partner\", \"next_step\": \"Call describe_available with your question to see which models exist, or pass a model like 'res.partner'.\"}}, \"required\": [\"model\"]}"
      }
    }
  },
  {
    "builtin_name": "describe_available",
    "fields": {
      "description": {
        "source_sha256": "e6e03f42c1ee66a1f37b33b64adca0a2f93cbb92948bebe28776d131e99bd430",
        "value": "根据自然语言问题查找已安装的相关模型，并指出承载内容、时间、客户、状态和操作的字段。猜测模型名或反复搜索 ir.model 之前先调用，直接找到筛选和排序所需字段。"
      },
      "parameters": {
        "source_sha256": "8a443ab88677bd3c1c1d4d8d5fa7e6d007cc80cda124b96c98a37b2a863058e0",
        "value": "{\"type\": \"object\", \"properties\": {\"question\": {\"type\": \"string\", \"description\": \"\\u8981\\u67e5\\u627e\\u7684\\u5185\\u5bb9\\uff0c\\u4f8b\\u5982\\u90ae\\u4ef6\\u3001\\u4f1a\\u8bae\\u3001\\u53d1\\u7968\\u3002\", \"example\": \"mail fr\\u00e5n en kund\"}}, \"required\": [\"question\"]}"
      }
    }
  },
  {
    "builtin_name": "odoo_search",
    "fields": {
      "description": {
        "source_sha256": "1a0a4290baff994b4b8a5612f7129de035fa33af421d18583d3b1f1cf6cb7987",
        "value": "使用 Odoo domain 语法通过 ORM 的 search_read 查询记录。默认返回 id、name、display_name、create_date；可通过 fields 指定其他字段。limit 默认 20。"
      },
      "parameters": {
        "source_sha256": "3d7dfb43bf61ca112d3335cfb4097920f9f84d7ef802bb91777cb1f7e8eef53e",
        "value": "{\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\"}, \"domain\": {\"type\": \"array\", \"description\": \"Odoo \\u67e5\\u8be2\\u6761\\u4ef6\\uff0c\\u4f8b\\u5982 [[\\\"state\\\", \\\"=\\\", \\\"draft\\\"]]\\u3002\", \"items\": {\"type\": \"array\"}}, \"fields\": {\"type\": \"array\", \"items\": {\"type\": \"string\"}}, \"limit\": {\"type\": \"integer\", \"default\": 20}, \"offset\": {\"type\": \"integer\"}, \"order\": {\"type\": \"string\"}}, \"required\": [\"model\"]}"
      }
    }
  },
  {
    "builtin_name": "odoo_create",
    "fields": {
      "description": {
        "source_sha256": "f2caf54c1f52093e8daeae05279ce57b2a831e65d6509603fa4ddfba6d1ec870",
        "value": "通过 ORM 业务层创建记录，应用默认值和 onchange，返回 id、display_name。需要审批。"
      },
      "parameters": {
        "source_sha256": "2b3cf1fa0cdd0360be0bb193837b4796038ff97b054d776273b26b759de3b1e8",
        "value": "{\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\"}, \"values\": {\"type\": \"object\", \"description\": \"\\u5b57\\u6bb5\\u503c\\u3002\"}}, \"required\": [\"model\", \"values\"]}"
      }
    }
  },
  {
    "builtin_name": "odoo_call_method",
    "fields": {
      "description": {
        "source_sha256": "386a41d42e17f1ffa94801c3aa8f0a1788048d93ded4830d08fc0db729316222",
        "value": "调用记录的 action_*、button_* 业务方法，例如 action_confirm、action_post。业务流转应调用方法而非直接写 state。始终需要人工审批（HITL）。"
      },
      "parameters": {
        "source_sha256": "6bac71c96233f01734119f51fd1f423f829e5a2b79e0d75a41e960216ab59cf8",
        "value": "{\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\"}, \"id\": {\"type\": \"integer\"}, \"method\": {\"type\": \"string\", \"description\": \"\\u4e1a\\u52a1\\u65b9\\u6cd5\\u540d\\uff0c\\u5fc5\\u987b\\u4ee5 action_ \\u6216 button_ \\u5f00\\u5934\\uff0c\\u6216\\u4f4d\\u4e8e\\u5141\\u8bb8\\u5217\\u8868\\u3002\"}, \"args\": {\"type\": \"object\", \"description\": \"\\u53ef\\u9009\\u7684\\u547d\\u540d\\u53c2\\u6570\\u3002\"}}, \"required\": [\"model\", \"id\", \"method\"]}"
      }
    }
  },
  {
    "builtin_name": "odoo_write",
    "fields": {
      "description": {
        "source_sha256": "8392d9d15844962e1bc6ba548ce70d4537b9ee491012c4d9d76b99505c2264ae",
        "value": "更新记录中的安全字段。state、move_type、journal_id、amount_* 等业务字段应通过 odoo_call_method 流转，不能直接写入。需要审批。"
      }
    }
  },
  {
    "builtin_name": "odoo_attach",
    "fields": {
      "description": {
        "source_sha256": "c2cfbd34324dd19fd36cff634958f6a27329f4e462ba6d02cd574ec28ec6f970",
        "value": "在文件路径与 Odoo 记录的二进制字段间传输文件，适用于 ir.attachment 及其他含二进制字段的模型。先下载到磁盘处理，再写回结果。文件正文保持在模型上下文外，仅传递路径；写入已有记录需要审批。"
      },
      "parameters": {
        "source_sha256": "843827fd080936c663f24a4899dbf60975e019d8cc2f01b42fca8ed3620f9330",
        "value": "{\"type\": \"object\", \"properties\": {\"model\": {\"type\": \"string\", \"description\": \"Odoo \\u6a21\\u578b\\u540d\\u79f0\\uff0c\\u4f8b\\u5982 ir.attachment\\u3002\"}, \"id\": {\"type\": \"integer\", \"description\": \"\\u8bb0\\u5f55 ID\\u3002\"}, \"field\": {\"type\": \"string\", \"description\": \"\\u4e8c\\u8fdb\\u5236\\u5b57\\u6bb5\\uff0c\\u4f8b\\u5982 content\\u3001raw\\u3002\"}, \"path\": {\"type\": \"string\", \"description\": \"\\u6587\\u4ef6\\u7edd\\u5bf9\\u8def\\u5f84\\uff0c\\u6216\\u76f8\\u5bf9\\u4e8e\\u667a\\u80fd\\u4f53\\u5de5\\u4f5c\\u76ee\\u5f55\\u7684\\u8def\\u5f84\\u3002\"}, \"direction\": {\"type\": \"string\", \"enum\": [\"in\", \"out\"], \"description\": \"out \\u8868\\u793a\\u5b57\\u6bb5\\u5199\\u5165\\u6587\\u4ef6\\uff0cin \\u8868\\u793a\\u6587\\u4ef6\\u5199\\u56de\\u5b57\\u6bb5\\u3002\"}}, \"required\": [\"model\", \"id\", \"field\", \"path\", \"direction\"]}"
      }
    }
  },
  {
    "builtin_name": "odoo_unlink",
    "fields": {
      "description": {
        "source_sha256": "32ac29a837b80e3ae30d060d886f9e7bdd1f533fee6a71c672738f8192ca9efe",
        "value": "删除记录，属于破坏性操作，始终需要人工明确批准，不能绕过审批。"
      }
    }
  },
  {
    "builtin_name": "okf_search",
    "fields": {
      "description": {
        "source_sha256": "fda7d1aa14502c2e8ab3afffc39c12ce05926d892727573af101a256224c22af",
        "value": "搜索 ai.okf.concept 知识概念，混合向量和全文检索并按访问权限过滤。在已配置 OKF 时用于查询流程与背景知识。"
      },
      "parameters": {
        "source_sha256": "f5fe7285e23039c3835dd7ddc7078fd04849061f793d5b3df617716ced344ebe",
        "value": "{\"type\": \"object\", \"properties\": {\"query\": {\"type\": \"string\"}, \"scope\": {\"type\": \"string\", \"enum\": [\"company\", \"personal\", \"coworker\"]}, \"limit\": {\"type\": \"integer\", \"default\": 10}, \"period\": {\"type\": \"string\", \"description\": \"\\u53ef\\u9009\\uff0c\\u4ec5\\u5728\\u8986\\u76d6\\u81ea\\u52a8\\u65f6\\u95f4\\u8303\\u56f4\\u65f6\\u586b\\u5199\\u3002\\u652f\\u6301\\u745e\\u5178\\u8bed\\u76f8\\u5bf9\\u65f6\\u95f4\\u8868\\u8fbe\\uff0c\\u4f8b\\u5982 i veckan\\u3001senaste m\\u00e5naden\\u3001f\\u00f6rra \\u00e5ret\\u3002\\u901a\\u5e38\\u7559\\u7a7a\\uff1a\\u90ae\\u4ef6\\u9ed8\\u8ba4\\u8fc7\\u53bb 7 \\u5929\\uff0c\\u65e5\\u5386\\u9ed8\\u8ba4\\u672a\\u6765 7 \\u5929\\uff0c\\u67e5\\u8be2\\u4e2d\\u7684\\u65f6\\u95f4\\u8868\\u8fbe\\u4f1a\\u81ea\\u52a8\\u8bc6\\u522b\\u3002\"}}, \"required\": [\"query\"]}"
      }
    }
  },
  {
    "builtin_name": "delegate_task",
    "fields": {
      "description": {
        "source_sha256": "a5d4953dfab957e653ff6e9e547a656ec1c9d6df56dc1ae2b990f0a65be29d07",
        "value": "向同部门的 ai.coworker 同事分派任务。仅用于自己能力之外、同级或下级同事可完成的工作，例如请同部门运维同事检查日志；不能向上级委派或跨部门委派，上报属于升级流程。任务携带当前信任等级，由对方通过 Heartbeat 按自己的节奏处理并返回结果。有效收件人见系统提示中的同事目录。"
      },
      "parameters": {
        "source_sha256": "18faf1533dac9a8e7470214efb45b4749d5428555289913afa7c00a3302a40b0",
        "value": "{\"type\": \"object\", \"properties\": {\"target_coworker\": {\"type\": \"string\", \"description\": \"\\u63a5\\u6536\\u4efb\\u52a1\\u7684\\u540c\\u4e8b\\u540d\\u79f0\\uff0c\\u53c2\\u7167\\u540c\\u4e8b\\u76ee\\u5f55\\u3002\"}, \"description\": {\"type\": \"string\", \"description\": \"\\u660e\\u786e\\u8bf4\\u660e\\u8981\\u5b8c\\u6210\\u7684\\u5de5\\u4f5c\\uff0c\\u5fc5\\u586b\\uff1b\\u7a7a\\u8bf4\\u660e\\u4f1a\\u5bfc\\u81f4\\u4efb\\u52a1\\u65e0\\u6cd5\\u6267\\u884c\\u3002\"}, \"name\": {\"type\": \"string\", \"description\": \"\\u7b80\\u77ed\\u6807\\u9898\\uff0c\\u9ed8\\u8ba4\\u4f7f\\u7528 description\\u3002\"}, \"priority\": {\"type\": \"string\", \"enum\": [\"0\", \"1\", \"2\", \"3\"], \"description\": \"0=\\u4f4e\\uff0c1=\\u666e\\u901a\\uff0c2=\\u9ad8\\uff0c3=\\u7d27\\u6025\\u3002\"}}, \"required\": [\"target_coworker\", \"description\"]}"
      }
    }
  },
  {
    "builtin_name": "push_notification",
    "fields": {
      "description": {
        "source_sha256": "b6675987ea6b9afe93777f6f03033bbcdde1a97dde4ec6808bb75489a0e2ca43",
        "value": "向当前会话所属用户发送推送。长任务开始前通知用户可以离开聊天，或用于后台任务完成提醒。收件人固定为会话用户，不能指定其他人。返回是否成功加入队列；没有注册设备时明确返回失败，不声称已发送。"
      },
      "parameters": {
        "source_sha256": "c8f54ae303529c1d36af8a8c0de68153904f7b7ee9def66e0bf5a715044a9539",
        "value": "{\"type\": \"object\", \"properties\": {\"title\": {\"type\": \"string\", \"description\": \"\\u7b80\\u77ed\\u6807\\u9898\\uff0c\\u6700\\u591a\\u7ea6 60 \\u5b57\\u7b26\\u3002\"}, \"body\": {\"type\": \"string\", \"description\": \"\\u7528\\u4e00\\u81f3\\u4e24\\u53e5\\u8bdd\\u8bf4\\u660e\\u80cc\\u666f\\u3002\"}, \"url\": {\"type\": \"string\", \"description\": \"\\u70b9\\u51fb\\u901a\\u77e5\\u65f6\\u6253\\u5f00\\u7684\\u8def\\u5f84\\uff0c\\u4f8b\\u5982 /ai/chat\\uff0c\\u9ed8\\u8ba4\\u4e5f\\u662f /ai/chat\\u3002\"}}, \"required\": [\"title\", \"body\"]}"
      }
    }
  },
  {
    "builtin_name": "mail_digest",
    "fields": {
      "description": {
        "source_sha256": "175972360840d57250d1b05a6f538d49c867992ebb17b2d14c5ace22e8406892",
        "value": "一次调用获取用户的重要邮件并按重要性排序，逐条说明理由，避免手工查找邮件模型。action_needed 权重 3、follow_up_at 权重 2、customer 权重 1；interest_score 仅展示，不参与排序。默认回看 7 天；missed 列出 7 至 30 天内仍需处理的邮件，更早邮件只统计数量；upcoming 返回未来 7 天的日历活动，以辅助判断邮件紧急性。询问邮箱或邮件时优先使用。"
      },
      "parameters": {
        "source_sha256": "add805766383eb4d4747b63395f0f59c50d90183233712ecb2c63122767913ad",
        "value": "{\"type\": \"object\", \"properties\": {\"limit\": {\"type\": \"integer\", \"default\": 5, \"description\": \"\\u8fd4\\u56de\\u90ae\\u4ef6\\u6570\\u91cf\\uff0c\\u9ed8\\u8ba4 5\\u3002\"}, \"since_days\": {\"type\": \"integer\", \"default\": 7, \"description\": \"\\u56de\\u6eaf\\u5929\\u6570\\uff0c\\u9ed8\\u8ba4 7\\u3002\\u7528\\u6237\\u672a\\u53e6\\u884c\\u6307\\u5b9a\\u65f6\\uff0c\\u201c\\u6700\\u8fd1\\u201d\\u8868\\u793a\\u8fc7\\u53bb\\u4e00\\u5468\\u30020 \\u8868\\u793a\\u4e0d\\u9650\\uff0c\\u5927\\u578b\\u90ae\\u7bb1\\u8bf7\\u8c28\\u614e\\u4f7f\\u7528\\u3002\"}, \"only_action_needed\": {\"type\": \"boolean\", \"default\": false, \"description\": \"\\u4ec5\\u8fd4\\u56de\\u9700\\u8981\\u5904\\u7406\\u7684\\u90ae\\u4ef6\\u3002\"}, \"include_missed\": {\"type\": \"boolean\", \"default\": true, \"description\": \"\\u540c\\u65f6\\u5217\\u51fa\\u8d85\\u8fc7 7 \\u5929\\u3001\\u4ecd\\u9700\\u5904\\u7406\\u7684\\u90ae\\u4ef6\\u3002\"}, \"missed_days\": {\"type\": \"integer\", \"default\": 30, \"description\": \"missed \\u67e5\\u8be2\\u7684\\u6700\\u957f\\u56de\\u6eaf\\u5929\\u6570\\uff1b\\u66f4\\u65e9\\u90ae\\u4ef6\\u53ea\\u7edf\\u8ba1\\u6570\\u91cf\\uff0c\\u4e0d\\u9010\\u6761\\u5217\\u51fa\\u3002\"}, \"lookahead_days\": {\"type\": \"integer\", \"default\": 7, \"description\": \"\\u540c\\u65f6\\u8fd4\\u56de\\u672a\\u6765 N \\u5929\\u7684\\u65e5\\u5386\\u6d3b\\u52a8\\uff0c\\u9ed8\\u8ba4 7 \\u5929\\uff1b\\u4e34\\u8fd1\\u4e8b\\u9879\\u6709\\u52a9\\u4e8e\\u5224\\u65ad\\u90ae\\u4ef6\\u7d27\\u6025\\u6027\\u3002\"}}, \"required\": []}"
      }
    }
