        "value": "列出可用于快捷操作绑定的 Odoo 模型 ir.model。"
      }
    }
  },
  {
    "builtin_name": "builder_create_quest",
    "fields": {
      "description": {
        "source_sha256": "cfb041452be9f29fd28f8fff93d916908f74245f8c4ee6df2fea4ec5b91f19ff",
        "value": "创建 ai.coworker。参数：必填 name，可选 description、init_types 列表、orchestration_mode（single、supervisor、buzz）。返回 AI 员工 ID。"
      },
      "parameters": {
        "source_sha256": "efa35396a1db28dff0dea1fc7b52d1ae174bd9e629d6a19d97f4fe839e48abcc",
        "value": "{\"type\": \"object\", \"properties\": {\"name\": {\"type\": \"string\", \"description\": \"AI \\u5458\\u5de5\\u540d\\u79f0\\u3002\"}, \"description\": {\"type\": \"string\", \"description\": \"\\u7cfb\\u7edf\\u6307\\u4ee4\\u6216 AI \\u5458\\u5de5\\u8bf4\\u660e\\u3002\"}, \"init_types\": {\"type\": \"string\", \"description\": \"\\u9017\\u53f7\\u5206\\u9694\\u7684\\u542f\\u52a8\\u65b9\\u5f0f\\uff1aweb_ui\\u3001chat\\u3001powerbox\\u3001mail\\u3001cron\\u3001server_action\\u3001manual\\u3002\"}, \"orchestration_mode\": {\"type\": \"string\", \"enum\": [\"single\", \"supervisor\", \"buzz\"], \"description\": \"\\u7f16\\u6392\\u6a21\\u5f0f\\uff1bsupervisor \\u542f\\u7528\\u591a\\u667a\\u80fd\\u4f53\\u4efb\\u52a1\\u59d4\\u6d3e\\u3002\"}}, \"required\": [\"name\"]}"
      }
    }
  },
  {
    "builtin_name": "builder_update_quest",
    "fields": {
