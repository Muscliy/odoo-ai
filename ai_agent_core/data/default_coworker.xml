<?xml version="1.0" encoding="utf-8"?>
<!--
    Default AI-medarbetare: "Allmän assistent"

    Definieras som data-XML (noupdate) så att den har stabila xmlids:
    - coworker_default_assistent   → refereras av chat-UI som default
    - agent_default_core           → hjärnan (agent), "Allmän kärna"
    - coworker_agent_default_core  → länk coworker ↔ agent

    Init-typer ägs av denna data-XML via de stored init_*-booleskorna
    (init_web_ui, init_chat, init_channel m.fl.). De speglas till
    ai.coworker.init_type-rader av _sync_init_types_from_booleans(),
    som körs i write() när init_*-fälten ändras.

    Varför inte lita på create()/_ensure_all_init_types: den sätter bara
    manual + web_ui som aktiva, och körs aldrig om för en post som redan
    finns (noupdate). Default-medarbetaren ska vara synlig i BÅDE
    web-UI:t, Discuss-chatten och team-kanalen — det ska stå här, inte
    härledas av en hårdkodad tuple i Python.

    Adoption av legacy-poster ("Allmän" från hooks/migration 1.8) görs av
    _ensure_default_coworker — anropas av <function> NEDANFÖR noupdate-
    blocket, eftersom funktioner i noupdate-block inte körs vid uppdatering
    (endast vid install).
-->
<odoo>
    <data noupdate="1">

        <record id="coworker_default_assistent" model="ai.coworker">
            <field name="name">通用助手</field>
            <field name="description">通用 AI 助手，帮助回答问题、协调组织工作，并通过持续改进提出优化建议。</field>
            <!-- Legacy-fältet init_type behålls för bakåtkompatibilitet
                 (migrationskod läser det). Sanningen om vilka kanaler som
                 är aktiva är init_*-booleskorna nedan. -->
            <field name="init_type">manual</field>
            <!-- Kanaler: default-medarbetaren ska nås överallt ifrån. -->
            <field name="init_web_ui" eval="True"/>
            <field name="init_chat" eval="True"/>
            <field name="init_channel" eval="True"/>
            <field name="status">active</field>
            <field name="heartbeat_enabled" eval="True"/>
            <field name="inject_company_memory" eval="True"/>
            <field name="inject_nudging" eval="True"/>
        </record>

        <record id="agent_default_core" model="ai.agent">
            <field name="name">通用核心助手</field>
            <field name="ai_role">通用 AI 助手</field>
            <field name="description">通用助手的核心智能体，回答问题、协调组织工作，并将任务委派给领域专员。</field>
            <field name="status">active</field>
        </record>

        <record id="coworker_agent_default_core" model="ai.coworker.agent">
            <field name="coworker_id" ref="coworker_default_assistent"/>
            <field name="agent_id" ref="agent_default_core"/>
            <field name="role">leader</field>
            <field name="sequence" eval="10"/>
        </record>

        <!-- Odoo-specialist (affärsverktyg + odoo-core-skill) -->
        <record id="agent_odoo_business" model="ai.agent">
            <field name="name">Odoo 业务专员</field>
            <field name="ai_role">Odoo 业务专家</field>
            <field name="description">熟悉 Odoo 模型的业务专家，使用通用模型工具查询、创建记录和执行业务流程，并遵循 odoo-core 技能。</field>
            <field name="status">active</field>
            <field name="skill_ids" eval="[(6, 0, [ref('skill_odoo_core')])]"/>
            <!-- explicit-agent-tools: odoo-verktyg anges EXPLICIT här — de
                 registreras inte längre implicit via builtin_tools(). -->
            <field name="tool_ids" eval="[(6, 0, [
                ref('tool_describe_model'),
                ref('tool_odoo_search'),
                ref('tool_odoo_create'),
                ref('tool_odoo_call_method'),
                ref('tool_odoo_write'),
                ref('tool_odoo_unlink'),
                ref('tool_okf_search'),
            ])]"/>
        </record>
        <record id="coworker_agent_odoo_business" model="ai.coworker.agent">
            <field name="coworker_id" ref="coworker_default_assistent"/>
            <field name="agent_id" ref="agent_odoo_business"/>
            <field name="role">member</field>
            <field name="sequence" eval="20"/>
        </record>

        <!-- Research (webb + youtube) — skapas av _ensure_default_coworker()
             (ai_coworker.py), som anropas av <function> längst ned i denna
             fil. Se även _adopt('agent_research', ['odoo_web_search',
             'odoo_fetch_url']) i _migrate_* för de odoo-prefixade verktygen.

             OBS: agenten definieras INTE här som data-XML. Två definitioner
             (XML + Python) gav en dubblerad coworker↔agent-koppling, så
             agenten skulle anropas två gånger. Python-vägen är den enda
             källan.

             Skill-posterna (skill_youtube_*) ägs av ai_agent_core som
             modul-data — SKILL.md-filerna på disk är kopior, och importören
             rapporterar dem som kollisioner om de glider isär
             (se openspec/changes/pi-skill-sync). -->

        <!-- Office-dokument (Office + PDF, extern runtime).
             runtime='external' → agenten startas som en pi-agent-process
             med bash, så den kan anropa python-pptx/soffice direkt.
             Skillen är metodiken; odoo_attach är kanalen för filbytes. -->
        <record id="agent_office_dokument" model="ai.agent">
            <field name="name">办公文档专员</field>
            <field name="ai_role">办公文档专家</field>
            <field name="description">读取、创建和修改 Office 文档（docx、xlsx、pptx、odt、ods、odp）及 PDF，支持扫描 PDF 的 OCR。通过 odoo_attach 获取和交付文件，适用于 ir.attachment、dms.file 及其他包含二进制字段的模型。</field>
            <field name="status">active</field>
            <field name="runtime">external</field>
            <field name="skill_ids" eval="[(6, 0, [ref('skill_office_dokument')])]"/>
            <field name="tool_ids" eval="[(6, 0, [
                ref('tool_describe_model'),
                ref('tool_odoo_search'),
                ref('tool_odoo_create'),
                ref('tool_odoo_write'),
                ref('tool_odoo_attach'),
                ref('tool_odoo_call_method'),
            ])]"/>
        </record>
        <record id="coworker_agent_office_dokument" model="ai.coworker.agent">
            <field name="coworker_id" ref="coworker_default_assistent"/>
            <field name="agent_id" ref="agent_office_dokument"/>
            <field name="role">member</field>
            <field name="sequence" eval="40"/>
        </record>

        <!-- Nyhetsbevakare (omvärldsbevakning).
             Läser RSS/Atom via news_fetch och svarar med en cachad
             dygnsdigest (news_digest → ai.personal.memory). Källistan bor i
             skillen news-sources; personliga källor och intressen i
             användarens personliga minne. -->
        <record id="agent_news_watcher" model="ai.agent">
            <field name="name">新闻观察员</field>
            <field name="ai_role">新闻观察员</field>
            <field name="description">回答新闻动态问题，使用每日缓存生成 7–10 条按重要程度排序的简报，支持主题筛选和记录来源、主题、数量偏好。</field>
            <field name="status">active</field>
            <field name="skill_ids" eval="[(6, 0, [
                ref('skill_news_briefing'),
                ref('skill_news_sources'),
            ])]"/>
            <field name="tool_ids" eval="[(6, 0, [
                ref('tool_news_fetch'),
                ref('tool_news_digest'),
                ref('tool_okf_search'),
                ref('tool_personal_memory'),
            ])]"/>
        </record>
        <record id="coworker_agent_news_watcher" model="ai.coworker.agent">
            <field name="coworker_id" ref="coworker_default_assistent"/>
            <field name="agent_id" ref="agent_news_watcher"/>
            <field name="role">member</field>
            <field name="sequence" eval="50"/>
        </record>

    </data>

    <!-- Adoption av legacy-poster + städning av duplikat. Körs vid BÅDE
         init och update (utanför noupdate-block). obj() = tom recordset
         → anropar modellmetoden utan specifika rader. -->
    <function model="ai.coworker" name="_ensure_default_coworker" eval="[obj()]"/>

</odoo>
